        "[REDACTED]",
    ),
    # IPv4 addresses
    (
        re.compile(
            r"\b(?:(?:25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|1?\d?\d)\b"
        ),
        "[REDACTED]",
    ),
    # IPv6 addresses (full or :: compressed, avoiding timestamps, PCI IDs, and C++ ::)
    (
        re.compile(
            r"(?<![:\w])(?:[0-9a-fA-F]{1,4}:){3,7}[0-9a-fA-F]{1,4}(?:%[A-Za-z0-9_.-]+)?(?![:\w.])"
        ),
        "[REDACTED]",
    ),
    (
        re.compile(
            r"(?<![:\w])(?:[0-9a-fA-F]{1,4}:){1,6}:(?:[0-9a-fA-F]{1,4}(?::[0-9a-fA-F]{1,4})*)?(?:%[A-Za-z0-9_.-]+)?(?![:\w.])"
        ),
        "[REDACTED]",
    ),
    # Email addresses
    (re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"), "[REDACTED]"),
    # Long 32+ char hex identifiers (machine-id, hashes, session hex)
    (re.compile(r"\b[0-9a-fA-F]{32,}\b"), "[REDACTED]"),
]

REDACTED_TOKEN_RE = re.compile(r"(\[REDACTED\])")


def sanitize(line: str) -> str:
    for rx, repl in PATTERNS:
        line = rx.sub(repl, line)
    return line


# -------------------------------------------------------------
# 1. Log Consumer Thread (journalctl)
# -------------------------------------------------------------
def log_worker():
    global LOG_QUEUE, RUNNING
    cmd = ["journalctl", "-f", "-n", "60", "--output=short-iso", "--no-pager"]
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        errors="replace",
    )
    while RUNNING:
        line = proc.stdout.readline()
        if not line:
            time.sleep(0.08)
            continue
        line = line.strip()
        if line:
            LOG_QUEUE.append(sanitize(line))
    proc.terminate()


# -------------------------------------------------------------
# 2. Custom Audio Analyzer Thread (parec -> numpy FFT)
# -------------------------------------------------------------
NUM_BANDS = 64
SAMPLE_RATE = 44100
FFT_SIZE = 2048


def audio_worker():
    global AUDIO_BARS, PEAK_BARS, RUNNING
    import numpy as np

    try:
        sink = subprocess.run(
            ["pactl", "get-default-sink"],
            capture_output=True,
            text=True,
            timeout=3,
        ).stdout.strip()
    except Exception:
        sink = "@DEFAULT_SINK@"

    cmd = [
        "parec",
        "--device",
        f"{sink}.monitor",
        "--format=s16le",
        f"--rate={SAMPLE_RATE}",
        "--channels=1",
        "--latency-msec=20",
    ]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

    window = np.hanning(FFT_SIZE)
    freqs = np.fft.rfftfreq(FFT_SIZE, 1.0 / SAMPLE_RATE)
    edges = np.logspace(math.log10(45), math.log10(14000), NUM_BANDS + 1)
    spans = []
    for i in range(NUM_BANDS):
        a = int(np.searchsorted(freqs, edges[i]))
        b = max(int(np.searchsorted(freqs, edges[i + 1])), a + 1)
        spans.append((a, b))

    tilt = np.linspace(1.0, 3.4, NUM_BANDS)
    buf = np.zeros(FFT_SIZE)
    smooth = np.zeros(NUM_BANDS)
    peaks = np.zeros(NUM_BANDS)
    peak_gain = 0.05
    chunk = 1024

    while RUNNING:
        data = proc.stdout.read(chunk * 2)
        if not data or len(data) < chunk * 2:
            time.sleep(0.02)
            continue
        s = np.frombuffer(data, dtype=np.int16).astype(np.float64) / 32768.0
        buf = np.roll(buf, -chunk)
        buf[-chunk:] = s

        spec = np.abs(np.fft.rfft(buf * window)) / FFT_SIZE
        mag = np.array([spec[a:b].max() for a, b in spans]) * tilt
        mag = np.sqrt(mag)

        peak_gain = max(peak_gain * 0.997, float(mag.max()), 0.12)
        norm = np.clip(mag / peak_gain, 0.0, 1.0)

        smooth = np.where(norm > smooth, norm * 0.75 + smooth * 0.25, smooth * 0.86 + norm * 0.14)
        peaks = np.where(smooth > peaks, smooth, np.maximum(0.0, peaks - 0.012))

        AUDIO_BARS = smooth.tolist()
        PEAK_BARS = peaks.tolist()

    proc.terminate()


# -------------------------------------------------------------
# 3. Lightweight System Vitals (/proc, zero subprocesses)
# -------------------------------------------------------------
class SystemVitals:
    def __init__(self):
        self.cpu_pct = 0.0
        self.mem_pct = 0.0
        self.mem_used_gb = 0.0
        self.mem_total_gb = 0.0
        self.uptime_str = "0m"
        self.cpu_hist = deque([0.0] * 12, maxlen=12)
        self._prev_total = 0
        self._prev_idle = 0
        self._last_poll = 0.0

    def update(self, now: float):
        if now - self._last_poll < 1.0:
            return
        self._last_poll = now
        try:
            with open("/proc/stat", "r") as f:
                parts = f.readline().split()
            vals = [int(x) for x in parts[1:9]]
            idle = vals[3] + vals[4]
            total = sum(vals)
            if self._prev_total > 0 and total > self._prev_total:
                dt_total = total - self._prev_total
                dt_idle = idle - self._prev_idle
                self.cpu_pct = max(0.0, min(100.0, 100.0 * (1.0 - dt_idle / dt_total)))
                self.cpu_hist.append(self.cpu_pct)
            self._prev_total, self._prev_idle = total, idle
        except Exception:
            pass

        try:
            mem = {}
            with open("/proc/meminfo", "r") as f:
                for line in f:
                    k, v = line.split(":", 1)
                    mem[k] = int(v.strip().split()[0])
                    if len(mem) >= 6 and "MemTotal" in mem and "MemAvailable" in mem:
                        break
            total_kb = mem.get("MemTotal", 1)
            avail_kb = mem.get("MemAvailable", 0)
            used_kb = max(0, total_kb - avail_kb)
            self.mem_pct = 100.0 * used_kb / total_kb
            self.mem_used_gb = used_kb / (1024 * 1024)
            self.mem_total_gb = total_kb / (1024 * 1024)
        except Exception:
            pass

        try:
            with open("/proc/uptime", "r") as f:
                secs = int(float(f.readline().split()[0]))
            days, rem = divmod(secs, 86400)
            hrs, rem = divmod(rem, 3600)
            mins = rem // 60
            if days > 0:
                self.uptime_str = f"{days}d {hrs}h"
            elif hrs > 0:
                self.uptime_str = f"{hrs}h {mins:02d}m"
            else:
                self.uptime_str = f"{mins}m"
        except Exception:
            pass


