    SHADER_CHARS = " ·:;=+*#%@"
    vitals = SystemVitals()

    # Light direction (normalized) for 3D Arch shading
    lx, ly, lz = -0.42, 0.58, 0.70
    l_norm = math.sqrt(lx * lx + ly * ly + lz * lz)
    lx, ly, lz = lx / l_norm, ly / l_norm, lz / l_norm

    angle_y = 0.0
    t1 = threading.Thread(target=log_worker, daemon=True)
    t2 = threading.Thread(target=audio_worker, daemon=True)
    t1.start()
    t2.start()

