# 4. High-Density 3D Arch Linux Chevron Mesh + Normals
# -------------------------------------------------------------
def _point_in_poly(x: float, y: float, poly) -> bool:
    inside = False
    n = len(poly)
    j = n - 1
    for i in range(n):
        xi, yi = poly[i]
        xj, yj = poly[j]
        if ((yi > y) != (yj > y)) and (x < (xj - xi) * (y - yi) / (yj - yi + 1e-12) + xi):
            inside = not inside
        j = i
    return inside


def build_arch_mesh():
    """
    Build a solid extruded 3D Arch Linux chevron with surface normals:
    returns list of (x, y, z, nx, ny, nz).
    """
    # Classic Arch Linux silhouette (normalized roughly to [-1.15..1.15] x [-1.2..1.25])
    poly = [
        (0.00, 1.25),    # sharp top apex
        (0.24, 0.70),    # right upper edge
        (0.45, 0.25),
        (0.32, 0.28),    # subtle right inner notch
        (0.55, 0.08),
        (0.86, -0.58),
        (1.16, -1.16),   # bottom-right foot
        (0.82, -1.02),   # arch inner right sweep
        (0.52, -0.94),
        (0.34, -0.82),
        (0.26, -0.58),   # inner arch dome right
        (0.18, -0.34),
        (0.00, -0.24),   # inner arch dome apex
        (-0.18, -0.34),
        (-0.26, -0.58),  # inner arch dome left
        (-0.34, -0.82),
        (-0.52, -0.94),
        (-0.82, -1.02),
        (-1.16, -1.16),  # bottom-left foot
        (-0.86, -0.58),
        (-0.55, 0.08),
        (-0.32, 0.28),   # subtle left inner notch
        (-0.45, 0.25),
        (-0.24, 0.70),
    ]

    pts = []
    half_d = 0.20

    # Front and back faces (dense grid)
    step = 0.062
    y = -1.18
    while y <= 1.26:
        x = -1.18
        while x <= 1.18:
            if _point_in_poly(x, y, poly):
                pts.append((x, y, half_d, 0.0, 0.0, 1.0))
                pts.append((x, y, -half_d, 0.0, 0.0, -1.0))
            x += step
        y += step

    # Extruded side walls with outward normals
    n = len(poly)
    z_layers = 7
    for i in range(n):
        x0, y0 = poly[i]
        x1, y1 = poly[(i + 1) % n]
        dx, dy = x1 - x0, y1 - y0
        seg_len = math.hypot(dx, dy)
        if seg_len < 1e-6:
            continue
        # Polygon is clockwise -> outward normal is (-dy, dx)
        nx, ny = -dy / seg_len, dx / seg_len
        steps = max(2, int(seg_len / 0.055))
        for s in range(steps):
            t = s / steps
            px = x0 + dx * t
            py = y0 + dy * t
            for kz in range(z_layers):
                pz = -half_d + (2.0 * half_d) * (kz / (z_layers - 1))
                pts.append((px, py, pz, nx, ny, 0.0))

    return pts


def build_orbital_ring():
    """Subtle tilted 3D halo ring around the Arch core."""
    ring = []
    num = 64
    r = 1.62
    for i in range(num):
        a = 2.0 * math.pi * i / num
        ring.append((r * math.cos(a), 0.15 * math.sin(a * 2.0), r * math.sin(a)))
    return ring


ARCH_MESH = build_arch_mesh()
ORBIT_RING = build_orbital_ring()

# -------------------------------------------------------------
# 5. Braille Subpixel Canvas Helper (2x4 dots per cell)
# -------------------------------------------------------------
BRAILLE_BITS = (
    (0x01, 0x08),
    (0x02, 0x10),
    (0x04, 0x20),
    (0x40, 0x80),
)


class BrailleCanvas:
    """High-resolution 2x4 subpixel canvas using Unicode Braille patterns."""

    def __init__(self, x0: int, y0: int, cols: int, rows: int):
        self.x0 = x0
        self.y0 = y0
        self.cols = max(1, cols)
        self.rows = max(1, rows)
        self.w = self.cols * 2
        self.h = self.rows * 4
        # (cell_y, cell_x) -> [bitmask, color_attr, priority]
        self.cells = {}

    def set_px(self, px: int, py: int, attr: int, priority: int = 1):
        if 0 <= px < self.w and 0 <= py < self.h:
            cx, dx = divmod(px, 2)
            cy, dy = divmod(py, 4)
            bit = BRAILLE_BITS[dy][dx]
            key = (cy, cx)
            cell = self.cells.get(key)
            if cell is None:
                self.cells[key] = [bit, attr, priority]
            else:
                cell[0] |= bit
                if priority >= cell[2]:
                    cell[1] = attr
                    cell[2] = priority

    def draw_line(self, x0: float, y0: float, x1: float, y1: float, attr: int, priority: int = 1):
        dx = x1 - x0
        dy = y1 - y0
        steps = max(1, int(max(abs(dx), abs(dy)) * 1.25))
        for i in range(steps + 1):
            t = i / steps
            self.set_px(int(round(x0 + dx * t)), int(round(y0 + dy * t)), attr, priority)

    def render(self, stdscr):
        for (cy, cx), (mask, attr, _) in self.cells.items():
            try:
                stdscr.addch(self.y0 + cy, self.x0 + cx, chr(0x2800 + mask), attr)
            except curses.error:
                pass


