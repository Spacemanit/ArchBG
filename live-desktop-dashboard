            ch = stdscr.getch()
            if ch in (ord("q"), ord("Q"), 27):
                RUNNING = False
                break
        except Exception:
            pass

        now = time.time()
        dt = min(0.1, max(0.001, now - last_time))
        last_time = now
        angle_y += 0.95 * dt
        angle_x = 0.22 + 0.10 * math.sin(now * 0.55)

        vitals.update(now)

        max_y, max_x = stdscr.getmaxyx()
        if max_y < 18 or max_x < 70:
            stdscr.erase()
            safe_addstr(stdscr, 0, 0, "Terminal too small...", C_WHITE)
            stdscr.refresh()
            continue

        stdscr.erase()

        # Leave breathing room at the top for Waybar (~50px -> ~3 rows)
        top_pad = 3 if max_y >= 28 else 1
        bottom_pad = 1
        side_pad = 2
        gap_x = 2
        gap_y = 1

        usable_w = max_x - side_pad * 2 - gap_x
        usable_h = max_y - top_pad - bottom_pad

        w_left = int(usable_w * 0.54)
        w_right = usable_w - w_left
        x_left = side_pad
        x_right = side_pad + w_left + gap_x

        h_top_right = (usable_h - gap_y) // 2
        h_bot_right = usable_h - gap_y - h_top_right
        y_top = top_pad
        y_bot_right = top_pad + h_top_right + gap_y

        pulse_dot = "●" if int(now * 2.0) % 2 == 0 else "○"

        # =====================================================
        # 1. LEFT BENTO CARD: LIVE SANITIZED SYSTEM LOGS
        # =====================================================
        draw_card(
            stdscr,
            y_top,
            x_left,
            usable_h,
            w_left,
            "󰞌 SYSTEM JOURNAL",
            f"{pulse_dot} LIVE · 󰒃 SANITIZED",
            C_BORDER,
            C_PRIMARY,
            C_MINT,
        )

        try:
            inner_x = x_left + 2
            inner_w = w_left - 4
            visible_lines = usable_h - 3
            logs = list(LOG_QUEUE)[-visible_lines:]

            unit_col_w = 13 if inner_w >= 54 else 9
            msg_offset = 10 + 2 + unit_col_w + 2  # "HH:MM:SS " + "● " + unit + "  "
            max_msg_len = max(8, inner_w - msg_offset)

            total_shown = len(logs)
            for idx, raw_log in enumerate(logs):
                row = y_top + 1 + idx
                if row >= y_top + usable_h - 1:
                    break

                ts, unit, msg = parse_log_line(raw_log)
                low = msg.lower()
                is_err = any(k in low for k in ("error", "fail", "crit", "panic", "denied", "segfault"))
                is_warn = (not is_err) and any(k in low for k in ("warn", "timeout", "retry", "deprecated"))
                is_kern = "kernel" in unit.lower()
                is_newest = idx == total_shown - 1

                if is_err:
                    glyph, glyph_attr = "●", C_ROSE
                    msg_attr = C_ROSE
                elif is_warn:
                    glyph, glyph_attr = "▲", C_AMBER
                    msg_attr = C_AMBER
                elif is_kern:
                    glyph, glyph_attr = "◆", C_CYAN_REG
                    msg_attr = C_CYAN_REG
                else:
                    glyph = "▸" if is_newest else "·"
                    glyph_attr = C_MINT_BOLD if is_newest else C_DIM
                    msg_attr = C_WHITE if is_newest else (C_TEXT if idx >= total_shown - 10 else C_MUTED)

                unit_disp = unit[:unit_col_w].ljust(unit_col_w)
                if len(msg) > max_msg_len:
                    msg = msg[: max_msg_len - 1] + "…"

                safe_addstr(stdscr, row, inner_x, f"{ts} ", C_DIM)
                safe_addstr(stdscr, row, inner_x + 9, f"{glyph} ", glyph_attr)
                safe_addstr(stdscr, row, inner_x + 11, unit_disp, C_CYAN_REG if is_kern else C_UNIT)

                # Render message with subtle violet highlight on [REDACTED]/[IP]/[WIFI]
                col = inner_x + 11 + unit_col_w + 1
                limit_x = x_left + w_left - 2
                for seg in REDACTED_TOKEN_RE.split(msg):
                    if not seg or col >= limit_x:
                        break
                    avail = limit_x - col
                    piece = seg[:avail]
                    attr = C_REDACTED if REDACTED_TOKEN_RE.fullmatch(seg) else msg_attr
                    safe_addstr(stdscr, row, col, piece, attr)
                    col += len(piece)
        except Exception:
            pass

        # =====================================================
        # 2. UPPER RIGHT BENTO CARD: BRAILLE RADIAL SPECTRUM
        # =====================================================
        bars = list(AUDIO_BARS)
        peaks = list(PEAK_BARS)
        energy = (sum(bars) / len(bars)) if bars else 0.0
        audio_active = energy > 0.015

        draw_card(
            stdscr,
            y_top,
            x_right,
            h_top_right,
            w_right,
            "󰎈 RADIAL SPECTRUM",
            f"{pulse_dot} ACTIVE" if audio_active else "◌ AMBIENT",
            C_BORDER,
            C_LILAC,
            C_PINK if audio_active else C_DIM,
        )

        try:
            vx0 = x_right + 2
            vy0 = y_top + 1
            v_cols = w_right - 4
            v_rows = h_top_right - 2

            if v_cols >= 12 and v_rows >= 6:
                canvas = BrailleCanvas(vx0, vy0, v_cols, v_rows)
                cx = canvas.w / 2.0
                cy = canvas.h / 2.0
                r_max = min(canvas.w, canvas.h) * 0.45
                r_in = r_max * 0.30

                nb = len(bars)
                bass = sum(bars[:6]) / 6.0 if nb >= 6 else 0.0
                spin = now * 0.14
                pal_n = len(VIS_PALETTE)

                # Ambient gentle breathing halo when silent
                idle_wave = 0.055 if not audio_active else 0.0

                # Inner pulsing double halo
                inner_r = r_in * (0.78 + 0.22 * bass + (0.04 * math.sin(now * 2.0) if not audio_active else 0.0))
                halo_color = VIS_PALETTE[min(pal_n - 1, int((0.15 + bass * 0.7) * (pal_n - 1)))]
                ring_steps = 120
                for k in range(ring_steps):
                    a = 2.0 * math.pi * k / ring_steps
                    px = int(round(cx + math.cos(a) * inner_r))
                    py = int(round(cy + math.sin(a) * inner_r))
                    canvas.set_px(px, py, halo_color, priority=2)

                # Outer subtle guide ring
                for k in range(0, 120, 3):
                    a = 2.0 * math.pi * k / 120 - spin * 0.5
                    px = int(round(cx + math.cos(a) * (r_max * 1.02)))
                    py = int(round(cy + math.sin(a) * (r_max * 1.02)))
                    canvas.set_px(px, py, C_BORDER, priority=0)

                # Mirrored radial rays + smooth outer waveform + peak sparks
                rays = 96
                tip_pts = []
                for k in range(rays):
                    frac = k / rays
                    m = 1.0 - abs(2.0 * frac - 1.0)
                    band = min(nb - 1, int(m * (nb - 1))) if nb > 0 else 0
                    val = bars[band] if nb > 0 else 0.0
                    pk = peaks[band] if nb > 0 else 0.0

                    # Subtle organic idle undulation when silent
                    if idle_wave > 0.0:
                        val = max(
                            val,
                            idle_wave
                            * (0.55 + 0.45 * math.sin(frac * 6.0 * math.pi + now * 1.8) * math.cos(now * 0.9)),
                        )

                    a = -math.pi / 2.0 + 2.0 * math.pi * frac + spin
                    ca, sa = math.cos(a), math.sin(a)
                    c_idx = min(pal_n - 1, int(m * (pal_n - 1)))
                    ray_attr = VIS_PALETTE[c_idx]
                    tip_attr = VIS_PALETTE[c_idx] | curses.A_BOLD

                    r_end = r_in + (0.04 + val * 0.92) * (r_max - r_in)
                    x_start = cx + ca * (r_in * 0.96)
                    y_start = cy + sa * (r_in * 0.96)
                    x_end = cx + ca * r_end
                    y_end = cy + sa * r_end

                    # Draw ray on every other step to keep airy elegance, plus full contour
                    if k % 2 == 0:
                        canvas.draw_line(x_start, y_start, x_end, y_end, ray_attr, priority=2)

                    tip_pts.append((x_end, y_end, tip_attr))

                    # Floating peak-hold spark
                    if pk > 0.06:
                        r_pk = r_in + (0.06 + pk * 0.95) * (r_max - r_in)
                        canvas.set_px(
                            int(round(cx + ca * r_pk)),
                            int(round(cy + sa * r_pk)),
                            tip_attr,
                            priority=4,
                        )

                # Connect tips into a silky smooth closed waveform contour
                for k in range(rays):
                    x0, y0, attr0 = tip_pts[k]
                    x1, y1, _ = tip_pts[(k + 1) % rays]
                    canvas.draw_line(x0, y0, x1, y1, attr0, priority=3)

                canvas.render(stdscr)

                # Center minimal label inside the inner ring
                center_row = vy0 + v_rows // 2
                center_col = vx0 + v_cols // 2
                if r_in >= 10:
                    icon_txt = "󰎈"
                    safe_addstr(stdscr, center_row, center_col - len(icon_txt) // 2, icon_txt, C_LILAC if audio_active else C_DIM)
        except Exception:
            pass

        # =====================================================
        # 3. LOWER RIGHT BENTO CARD: 3D ARCH CORE + SYSTEM VITALS
        # =====================================================
        draw_card(
            stdscr,
            y_bot_right,
            x_right,
            h_bot_right,
            w_right,
            "󰣇 ARCH CORE",
            f"UP {vitals.uptime_str}",
            C_BORDER,
            C_CYAN,
            C_MUTED,
        )

        try:
            ay0 = y_bot_right + 1
            ax0 = x_right + 2
            a_w = w_right - 4
            # Reserve 2 rows at bottom of card for vitals divider + strip
            show_vitals = h_bot_right >= 10 and a_w >= 38
            a_h = h_bot_right - (4 if show_vitals else 2)

            cx = ax0 + a_w // 2
            cy = ay0 + a_h // 2

            cos_y, sin_y = math.cos(angle_y), math.sin(angle_y)
            cos_x, sin_x = math.cos(angle_x), math.sin(angle_x)

            # Fit cleanly inside card
            scale_y = max(3.5, min(a_h * 0.42, 11.5))
            scale_x = scale_y * 2.05  # compensate ~2:1 terminal cell aspect

            z_buffer = {}
            arch_pal_n = len(ARCH_PALETTE)
            sh_n = len(SHADER_CHARS) - 1

            # Draw tilted orbital halo ring (behind and in front of logo via z-buffer)
            orb_ang = -now * 0.45
            oc, os_ = math.cos(orb_ang), math.sin(orb_ang)
            tilt_c, tilt_s = math.cos(0.42), math.sin(0.42)
            for rx0, ry0, rz0 in ORBIT_RING:
                rx1 = rx0 * oc + rz0 * os_
                rz1 = -rx0 * os_ + rz0 * oc
                ry2 = ry0 * tilt_c - rz1 * tilt_s
                rz2 = ry0 * tilt_s + rz1 * tilt_c + 3.6
                inv_z = 2.6 / rz2
                sx = int(round(cx + rx1 * scale_x * inv_z))
                sy = int(round(cy - ry2 * scale_y * inv_z))
                if ay0 <= sy < ay0 + a_h and ax0 <= sx < ax0 + a_w:
                    pos = (sy, sx)
                    if pos not in z_buffer or z_buffer[pos][0] > rz2:
                        dot_attr = C_DIM if rz2 > 3.7 else C_UNIT
                        z_buffer[pos] = (rz2, "·", dot_attr)

            # Draw solid shaded 3D Arch mesh
            for px, py, pz, nx, ny, nz in ARCH_MESH:
                # Rotate vertex
                x1 = px * cos_y + pz * sin_y
                z1 = -px * sin_y + pz * cos_y
                y2 = py * cos_x - z1 * sin_x
                z2 = py * sin_x + z1 * cos_x + 3.6

                # Rotate normal
                nx1 = nx * cos_y + nz * sin_y
                nz1 = -nx * sin_y + nz * cos_y
                ny2 = ny * cos_x - nz1 * sin_x
                nz2 = ny * sin_x + nz1 * cos_x

                inv_z = 2.6 / z2
                sx = int(round(cx + x1 * scale_x * inv_z))
                sy = int(round(cy - y2 * scale_y * inv_z))

                if ay0 <= sy < ay0 + a_h and ax0 <= sx < ax0 + a_w:
                    pos = (sy, sx)
                    if pos not in z_buffer or z_buffer[pos][0] > z2:
                        # Lambertian diffuse + ambient + soft specular
                        diff = max(0.0, nx1 * lx + ny2 * ly + nz2 * lz)
                        depth_boost = max(0.0, min(1.0, (4.3 - z2) / 1.4))
                        lum = min(1.0, 0.16 + 0.68 * diff + 0.22 * depth_boost)
                        char = SHADER_CHARS[max(1, int(lum * sh_n))]
                        c_idx = min(arch_pal_n - 1, int(lum * (arch_pal_n - 1)))
                        attr = ARCH_PALETTE[c_idx]
                        if lum > 0.78:
                            attr |= curses.A_BOLD
                        z_buffer[pos] = (z2, char, attr)

            for (sy, sx), (_, char, attr) in z_buffer.items():
                try:
                    stdscr.addch(sy, sx, char, attr)
                except curses.error:
                    pass

            # Bottom System Vitals strip inside the Arch Core card
            if show_vitals:
                sep_y = y_bot_right + h_bot_right - 3
                vit_y = y_bot_right + h_bot_right - 2
                safe_addstr(stdscr, sep_y, x_right + 1, "─" * (w_right - 2), C_BORDER)

                spark = render_sparkline(vitals.cpu_hist)
                mem_bar = render_bar(vitals.mem_pct, 8)
                cpu_str = f"󰍛 CPU {vitals.cpu_pct:4.1f}% "
                mem_str = f"󰘚 MEM {vitals.mem_used_gb:.1f}/{vitals.mem_total_gb:.0f}G "

                cur_x = ax0
                safe_addstr(stdscr, vit_y, cur_x, cpu_str, C_CYAN_REG)
                cur_x += len(cpu_str)
                safe_addstr(stdscr, vit_y, cur_x, spark, C_PRIMARY)
                cur_x += len(spark)

                sep_str = "  │  "
                if cur_x + len(sep_str) + len(mem_str) + len(mem_bar) <= x_right + w_right - 2:
                    safe_addstr(stdscr, vit_y, cur_x, sep_str, C_BORDER)
                    cur_x += len(sep_str)
                    safe_addstr(stdscr, vit_y, cur_x, mem_str, C_LILAC)
                    cur_x += len(mem_str)
                    safe_addstr(stdscr, vit_y, cur_x, mem_bar, C_PINK if vitals.mem_pct > 80 else C_MINT)
        except Exception:
            pass

        stdscr.refresh()
        time.sleep(0.012)


if __name__ == "__main__":
    curses.wrapper(main)
