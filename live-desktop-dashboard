HOST = socket.gethostname()
PATTERNS = [
    # Hostname (username, Wi-Fi SSIDs, Bluetooth & USB device names intentionally left unredacted)
    (re.compile(rf"\b{re.escape(HOST)}\b"), "[REDACTED]"),
    # URLs with embedded credentials
    (re.compile(r"\b[a-zA-Z][a-zA-Z0-9+.-]*://[^/\s:@]+:[^/\s@]+@[^\s]+"), "[REDACTED]"),
    # Bearer / Basic auth tokens
    (re.compile(r"(?i)\b(Bearer|Basic)\s+[A-Za-z0-9._\-+/=]{8,}"), r"\1 [REDACTED]"),
    # Passwords, secrets, API keys, tokens, cookies, session IDs
    (
        re.compile(
            r"(?i)\b(password|passwd|secret|token|api[_-]?key|access[_-]?key|private[_-]?key|auth(?:orization)?|cookie|session[_-]?id)\s*([:=])\s*['\"]?[^\s'\",;}{]+['\"]?"
        ),
        r"\1\2[REDACTED]",
    ),
    # Hardware / device serial numbers
    (
        re.compile(r"(?i)\b(serial(?:number)?)\s*([:=])\s*['\"]?[^\s'\",;]+['\"]?"),
        r"\1\2[REDACTED]",
    ),
    # MAC addresses (6-byte MACs and 14-byte UFW Ethernet header MACs)
    (re.compile(r"\b(?:[0-9a-fA-F]{2}[:-]){5,}[0-9a-fA-F]{2}\b"), "[REDACTED]"),
    # UUIDs
    (
        re.compile(
            r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b"
