# 6. UI Drawing Primitives (Bento Cards, Badges, Bars)
# -------------------------------------------------------------
def safe_addstr(stdscr, y: int, x: int, text: str, attr: int = 0):
    try:
        stdscr.addstr(y, x, text, attr)
    except curses.error:
        pass


def draw_card(stdscr, y: int, x: int, h: int, w: int, title: str, badge: str, border_attr: int, title_attr: int, badge_attr: int):
    """Draw a sleek rounded-corner bento panel with title and right-aligned badge."""
    if h < 4 or w < 12:
        return

    # Top border
    safe_addstr(stdscr, y, x, "╭" + "─" * (w - 2) + "╮", border_attr)
    # Side borders
    for r in range(y + 1, y + h - 1):
        safe_addstr(stdscr, r, x, "│", border_attr)
        safe_addstr(stdscr, r, x + w - 1, "│", border_attr)
    # Bottom border
    safe_addstr(stdscr, y + h - 1, x, "╰" + "─" * (w - 2) + "╯", border_attr)

    # Embedded title on top border
    if title:
        t_str = f" {title} "
        if len(t_str) < w - 6:
            safe_addstr(stdscr, y, x + 2, t_str, title_attr)

    # Right-aligned status badge on top border
    if badge:
        b_str = f" {badge} "
        bx = x + w - len(b_str) - 2
        if bx > x + len(title) + 5:
            safe_addstr(stdscr, y, bx, b_str, badge_attr)


def render_bar(pct: float, width: int) -> str:
    filled = int(round(max(0.0, min(100.0, pct)) / 100.0 * width))
    return "━" * filled + "╌" * (width - filled)


def render_sparkline(values) -> str:
    blocks = "▁▂▃▄▅▆▇█"
    out = []
    for v in values:
        idx = int(max(0.0, min(100.0, v)) / 100.0 * (len(blocks) - 1))
        out.append(blocks[idx])
    return "".join(out)


def parse_log_line(raw_log: str):
    """Split journalctl short-iso line into (time_str, unit, message)."""
    parts = raw_log.split(" ", 2)
    if len(parts) >= 3:
        ts = parts[0].split("T")[-1][:8]
        rest = parts[2]
    else:
        ts = "──:──:──"
        rest = raw_log

    if ": " in rest:
        unit_raw, msg = rest.split(": ", 1)
        # Strip [pid] from unit name for clean alignment
        unit = unit_raw.split("[", 1)[0].strip()
    else:
        unit = "sys"
        msg = rest

    return ts, unit, msg


